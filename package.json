{
  "name": "recordseek-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @recordseek/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "build": "pnpm -r --if-present build",
    "gate": "pnpm -r --if-present typecheck && pnpm -r --if-present lint && pnpm -r --if-present test:coverage"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "undici@<8.12.2": ">=8.12.2"
    }
  }
}
