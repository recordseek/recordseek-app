# FamilySearch developer app key (client_id). NOT a password and NOT a secret
# on the level of one — but still do not commit a real value; copy this file to
# `.env` and fill it in locally.
VITE_FS_APP_KEY=

# FamilySearch environment: production | beta | integration
# Use `beta` (sandbox) for the live auth check so write tests never touch a real tree.
VITE_FS_ENV=beta

# Send a PKCE challenge on login (default true). Set false to match the legacy web flow.
VITE_FS_PKCE=

# Sentry DSN for production error reporting (same project as the legacy app). Empty = off.
VITE_SENTRY_DSN=

# PostHog project key for anonymous product analytics (production builds only).
# This is a public client key; leave empty to use the built-in recordseek.com project key.
VITE_POSTHOG_KEY=
